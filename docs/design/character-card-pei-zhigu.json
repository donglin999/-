  "dialogue_state_definitions": [
    {
      "key": "neutral",
      "label": "走神后倾听",
      "body_and_emotion": "单脚自然承重、肩颈松，头侧向来人，透过古式细铜眼镜自然睁眼认真听，回神稍迟、嘴轻合；左手托半合抄校册在腰侧，右指夹书签停住页。",
      "semantic_family": "侧身夹签听述",
      "prop_support": "左掌与前臂承托书底，右指夹在页边固定书签；布囊由完整腰带系绳悬挂。",
      "sample_line": "嗯，我听着。这页先不翻。",
      "status": "internally_accepted_display_verified_game_mapping_pending"
    },
    {
      "key": "happy",
      "label": "查实欣喜",
      "body_and_emotion": "左手将合册收至肋侧，右手轻举沾墨拇指展示核验成功，肩身舒展、向来人点头而笑，不挥手招呼。",
      "semantic_family": "举墨指报喜",
      "prop_support": "左手与前臂持续托住合册底边，右手空置，仅展示本人拇指；不让书浮贴肋侧。",
      "sample_line": "找着了！这回是能对上的，不是我猜的。",
      "status": "internally_accepted_display_verified_game_mapping_pending"
    },
    {
      "key": "sad",
      "label": "为人惜字",
      "body_and_emotion": "左手托开册，右指缓慢抚过被划去的姓名，头偏低看页、右肩落下，眼神柔沉，嘴角收住，心疼资料中的人。",
      "semantic_family": "抚页惜字",
      "prop_support": "左掌托开放书册下缘，右指只轻触册页，不承担琴形或巨大书轴；纸与手指接触清楚。",
      "sample_line": "这页若只剩一个大姓，他们就又没了。",
      "status": "internally_accepted_display_verified_game_mapping_pending"
    },
    {
      "key": "angry",
      "label": "据理护证",
      "body_and_emotion": "左前臂将证据夹稳贴肋，右食指点在册页证据处，身体侧转护住资料、抬下巴直视，不悦据理争论，不推掌或拔棍。",
      "semantic_family": "侧身护册据理",
      "prop_support": "左掌与前臂夹持有底部承托的证据册，右食指明确落在朝外页边；书不透手，不悬空。",
      "sample_line": "旧本还在，你不能替他们改名字。",
      "status": "internally_accepted_display_verified_game_mapping_pending"
    },
    {
      "key": "surprise",
      "label": "停页确认",
      "body_and_emotion": "左手把册抬到胸上稳托，右指停在翻到一半的纸边，颈向前确认、眉眼骤抬、嘴轻分，是看到新证据而非后退贴胸。",
      "semantic_family": "抬册停页确认",
      "prop_support": "左掌托书脊与底边，右指捏页边停翻，纸页自然弯曲，书高于常态但不遮住整张脸。",
      "sample_line": "等一下，这一行……之前的本子里没有。",
      "status": "internally_accepted_display_verified_game_mapping_pending"
    },
    {
      "key": "engrossed",
      "label": "入迷考据",
      "body_and_emotion": "双手将折叠拓本展开到胸下，左手托底、右手捏纸角，身体半侧前倾、前脚探出、视线沉入细纹，忘记看谈话者但非嬉笑。",
      "semantic_family": "展拓前倾入迷",
      "prop_support": "左掌托拓本折叠下缘，右手捏侧纸角，两边可见抓握；折页自然垂落，不变悬空卷轴。",
      "sample_line": "先让我把这处缺口对上……啊，你还在等我。",
      "status": "internally_accepted_display_verified_game_mapping_pending"
    }
  ],
