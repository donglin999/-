  "dialogue_state_definitions": [
    {
      "key": "neutral",
      "label": "常态倾听",
      "body_and_emotion": "合扇横收在两手之间、位于腰前，肩放松、站直；肩颈自然松弛，头正常抬起，看向说话人，眉眼平静，嘴唇轻合，不欢迎挥手，也不做忧伤缩肩。道具：本人花扇"
    },
    {
      "key": "happy",
      "label": "开心认可",
      "body_and_emotion": "一手胸侧展花扇，另一手从腰侧向前展开掌心，身体轻转；肩背舒展，头略抬，身体向来人轻侧，眼神温暖，眉眼舒展、自然真实的小笑。道具：本人花扇"
    },
    {
      "key": "sad",
      "label": "伤心担忧",
      "body_and_emotion": "两臂收近身体，两手在腰前偏低握住本人随身物或衣缘，肩部明显低落内收，头微低、躯干轻侧、重心偏后；内眉收起、眼神低垂、嘴角轻落，成人忧心而非惊恐；绝不挥手、欢迎或微笑。本人随身道具仍稳妥挂腰/背负，不凭空换装。"
    },
    {
      "key": "angry",
      "label": "愤怒拒绝",
      "body_and_emotion": "一手将合扇横在胸下，另一掌向侧后示退，双脚稳定；肩背稳直，身体稍向前，重心前移，头正直、不低头；眉位压低、目光直接有力、唇线紧抿、绝不微笑，是明确的愤怒与拒绝。示停掌在胸下，不像抬高欢迎。道具：本人合扇。长棍/篙必须改为竖直置于身侧或贴身短斜角，两端完整留在画内，不横跨边缘。"
    },
    {
      "key": "surprise",
      "label": "惊讶发现",
      "body_and_emotion": "躯干小幅后仰、肩轻提、重心后移，头稍向前确认；一手靠近胸骨，另一手稳住本人腰侧/背负道具，肘贴近身体；眉轻抬、眼睛自然睁大、嘴唇小幅分开，成人吃惊。绝不挥手或欢快招呼，恰有两臂两腿。"
    },
    {
      "key": "tease",
      "label": "轻佻掩护",
      "body_and_emotion": "花扇半展置于唇侧但不遮住全部脸，另一手稳扶腰胯，髋部轻侧、头微倾、身体自信舒展；眼尾上扬、单侧唇角含笑，像在调笑又在留意别人，保持本人规则覆胸纱。"
    }
  ],
